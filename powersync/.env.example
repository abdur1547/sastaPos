# Copy this file to `.env` and fill in real values before running `docker compose up`.
# Never commit the real `.env` file (it is already covered by the repo .gitignore pattern *.env / .env).

# ---------------------------------------------------------------------------
# Port the PowerSync API/sync server listens on (also exposed on the host)
# ---------------------------------------------------------------------------
PS_PORT=8081

# ---------------------------------------------------------------------------
# Source database - the existing Postgres you already have running.
# Use host.docker.internal instead of localhost/127.0.0.1 so the PowerSync
# container (running on the Docker network) can reach a Postgres instance
# running on your host machine. If your Postgres already runs in Docker on a
# shared network, use that container's service name instead.
#
# When this file is run via the root ../docker-compose.yml (which imports this
# file via `include:` and adds a `postgres` service), use that service name
# instead: postgresql://powersync_role:CHANGE_ME@postgres:5432/sastaPos
# ---------------------------------------------------------------------------
PS_DATA_SOURCE_URI=postgresql://powersync_role:CHANGE_ME@postgres:5432/sastaPos

# ---------------------------------------------------------------------------
# Sync bucket storage - where PowerSync keeps its own replication/sync state.
# Simplest option: reuse the SAME Postgres server/database as above - PowerSync
# stores its data in a separate `powersync` schema, so it won't clash with your
# application tables. For production, prefer a dedicated database/user (or even
# a separate Postgres instance) so storage I/O doesn't compete with your app.
# ---------------------------------------------------------------------------
PS_STORAGE_SOURCE_URI=postgresql://powersync_role:CHANGE_ME@postgres:5432/sastaPos

# ---------------------------------------------------------------------------
# Client authentication (JWT). PowerSync validates JWTs issued by YOUR backend.
# The Spring Boot backend signs JWTs with HS256 using JWT_SECRET. PS_JWK_K must be
# the base64url (no padding) encoding of that exact secret:
#   printf '%s' "$JWT_SECRET" | base64 -w0 | tr '+/' '-_' | tr -d '='
# The value below matches the backend's default dev secret.
# ---------------------------------------------------------------------------
PS_JWK_K=ZGV2LW9ubHktY2hhbmdlLW1lLWluLXByb2R1Y3Rpb24tcGxlYXNlLXBsZWFzZS1wbGVhc2U

# ---------------------------------------------------------------------------
# Admin API token(s) - used to call PowerSync's own admin/API routes.
# Generate a strong random value, e.g.: openssl rand -hex 32
# ---------------------------------------------------------------------------
PS_API_TOKEN=CHANGE_ME_use_a_long_random_token
