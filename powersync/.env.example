# Standalone PowerSync / root DEVELOPMENT Compose configuration.
# Copy to .env; never commit real secrets. Root production Compose instead uses
# ../.env, explicit database credential fields, and an automatically derived JWK.
# REQUIRED means set explicitly; NOT REQUIRED means the default is sufficient.

# NOT REQUIRED: listening and published port; Compose default 8081.
# PS_PORT=8081

# REQUIRED: replication source URI, using the powersync_role credentials.
# Root development Compose hostname: postgres. Standalone Docker connecting to
# a host database: host.docker.internal. localhost means the container itself.
# Example: postgresql://powersync_role:HEX_PASSWORD@postgres:5432/sastaPos
# Password must match root POWERSYNC_DB_PASSWORD. Use URI-safe passwords such as
# openssl rand -hex 32: this PowerSync version does not decode URI passwords.
PS_DATA_SOURCE_URI=

# REQUIRED: sync bucket storage URI. May reuse the source URI; state is stored
# in a separate powersync schema. A dedicated storage database is preferable
# under heavy load; its user needs permission to create/use that schema.
# Example: postgresql://powersync_role:HEX_PASSWORD@postgres:5432/sastaPos
PS_STORAGE_SOURCE_URI=

# REQUIRED: base64url (without padding) encoding of the backend's JWT_SECRET.
# Generate after exporting JWT_SECRET:
# printf '%s' "$JWT_SECRET" | base64 -w0 | tr '+/' '-_' | tr -d '='
# Use the same secret as the backend, not a separately generated key.
PS_JWK_K=

# REQUIRED: independent random token for PowerSync admin/API routes.
# Generate with openssl rand -hex 32. Do not expose admin routes publicly.
PS_API_TOKEN=

# POWERSYNC_CONFIG_PATH and NODE_OPTIONS are set by Compose, not needed here.
# Database TLS and logging are configured in service.yaml, not via .env.
