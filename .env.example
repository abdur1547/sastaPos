# Copy this file to `.env` and fill in real values before running `docker compose up`.
# Never commit the real `.env` file (it is already covered by the repo .gitignore pattern *.env / .env).
#
# This dev-only root Docker Compose file runs the local Postgres instance used by the
# Spring Boot backend, and imports (`include:`) ./powersync/docker-compose.yaml so both
# services share one `docker compose up`. PowerSync's own vars (PS_*) still live in
# powersync/.env - copy powersync/.env.example separately and edit that too.
# Production infrastructure/config is managed separately.

# ---------------------------------------------------------------------------
# Postgres (used by both the Spring Boot backend and PowerSync)
# ---------------------------------------------------------------------------
POSTGRES_DB=sastaPos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
# Host port Postgres is exposed on (container always listens on 5432 internally).
POSTGRES_PORT=5433

# ---------------------------------------------------------------------------
# Spring Boot backend datasource.
# Docker Compose auto-configuration is disabled (spring.docker.compose.enabled=false),
# so start `docker compose up` manually before running the backend. These override
# the defaults in backend/src/main/resources/application.yml if your local values differ.
# ---------------------------------------------------------------------------
JDBC_DATABASE_URL=jdbc:postgresql://localhost:5433/sastaPos
JDBC_DATABASE_USERNAME=postgres
JDBC_DATABASE_PASSWORD=CHANGE_ME
