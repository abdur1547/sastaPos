# Production backend stack: PostgreSQL + Spring Boot backend + PowerSync.
# From the repository root: cp .env.example .env && chmod 600 .env
# Replace the four blank secrets below, review CORS_ALLOWED_ORIGINS, then run:
# docker compose -f docker-compose.prod.yml --env-file .env up -d --build --wait
# Only the root .env is used; no backend/.env or powersync/.env is needed.
# Development: docker compose up -d (hardcoded local settings; no .env needed).
#
# REQUIRED: set secrets explicitly; review prefilled non-secret values.
# NOT REQUIRED: defaults are sufficient. Uncomment only to override; do not
# assign blank values. This lists every root production Compose env input.
# Generate EACH secret independently with the command beside it. Random hex
# avoids Compose interpolation and database URI special-character issues.

# ============================================================================
# PostgreSQL
# ============================================================================
# REQUIRED
# Owner password, also used by the backend JDBC connection.
# Generate: openssl rand -hex 32
POSTGRES_PASSWORD=

# NOT REQUIRED
# Database name is shared by all services; owner is used by the backend.
# Set before first startup. Changing .env does not rename an existing DB/role.
# POSTGRES_DB=sastaPos
# POSTGRES_USER=postgres
# PostgreSQL image (PostgreSQL 18 volume layout).
# POSTGRES_IMAGE=postgres:18-alpine

# ============================================================================
# Backend (Spring Boot)
# ============================================================================
# REQUIRED
# HS256 signing secret of at least 32 bytes; also used by PowerSync.
# Generate: openssl rand -hex 32
# Use the generated text as-is; do not hex-decode it.
JWT_SECRET=

# Exact comma-separated client origins, never *. Prefilled for packaged Tauri
# clients on Linux/macOS/Windows; remove unused origins. For a hosted web UI,
# add its exact HTTPS origin. Add http://localhost:4200 only for Angular dev.
CORS_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost

# NOT REQUIRED
# HTTP port on both host and container; also used by the backend health check.
# Use an available unprivileged port (1024-65535), different from PS_PORT.
# BACKEND_PORT=8090
# Local image tag, built from ./backend by the startup command.
# BACKEND_IMAGE=sasta-pos-backend:prod
# Access token lifetime in seconds.
# JWT_EXPIRATION_SECONDS=3600
# Password-reset token lifetime in minutes.
# PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=15
# Defaults for newly created stores.
# DEFAULT_CURRENCY_CODE=PKR
# DEFAULT_TIMEZONE=Asia/Karachi

# ============================================================================
# PowerSync
# ============================================================================
# REQUIRED
# Separate replication/storage role password. PostgreSQL's first-start script
# creates powersync_role with this value; PowerSync uses it for both connections.
# Do not reuse POSTGRES_PASSWORD. Existing roles need an SQL password rotation,
# not just an edit here. Passed unchanged through explicit credential fields.
# Generate: openssl rand -hex 32
POWERSYNC_DB_PASSWORD=

# Independent admin API token, not a client login token. Keep admin routes private.
# Generate: openssl rand -hex 32
PS_API_TOKEN=

# NOT REQUIRED
# HTTP port on both host and container; also used by the PowerSync health check.
# Use an available unprivileged port (1024-65535), different from BACKEND_PORT.
# PS_PORT=8081
# Pinned image. Overrides must retain /app/service/lib/entry.js and unified mode.
# POWERSYNC_IMAGE=journeyapps/powersync-service@sha256:bf46f66e5dcc8f6a084de02ab51155dfa655bc610aa95009fff1c36f949c0acf

# ============================================================================
# Shared networking (backend + PowerSync)
# ============================================================================
# REQUIRED: none.

# NOT REQUIRED
# Bind both published HTTP ports to loopback for same-host desktop clients or
# a host TLS reverse proxy. Override only for private ingress, never public HTTP.
# SERVICE_BIND_ADDRESS=127.0.0.1

# Automatically supplied; do NOT add duplicate values here:
# Backend: SPRING_PROFILES_ACTIVE=prod, SERVER_PORT (from BACKEND_PORT),
# JDBC_DATABASE_URL,
# JDBC_DATABASE_USERNAME, JDBC_DATABASE_PASSWORD, production-safe JPA/Flyway
# settings, and image-default JAVA_TOOL_OPTIONS.
# PowerSync: POWERSYNC_CONFIG_PATH, PS_POSTGRES_DB, PS_DATABASE_PASSWORD,
# PS_JWK_K (base64url of JWT_SECRET), PS_PORT (from the setting above), and
# NODE_OPTIONS. POWERSYNC_CONFIG_PATH is /config/service.yaml inside the container,
# mounted from powersync/service.prod.yaml on the host.
# PS_DATA_SOURCE_URI / PS_STORAGE_SOURCE_URI are only for custom deployments
# using powersync/service.yaml, not this production stack.
