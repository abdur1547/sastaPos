# Root production Compose configuration. Copy to .env; never commit real secrets.
# Production: docker compose -f docker-compose.prod.yml --env-file .env up -d --build
# Development: docker compose up -d (hardcoded local settings; no .env needed).
# REQUIRED means you must set a value. NOT REQUIRED means the default is sufficient;
# leave commented variables unset unless you need to override the documented default.
# Production uses ONLY this file, not backend/.env or powersync/.env.

# REQUIRED: PostgreSQL owner password, shared by PostgreSQL and the backend.
# Generate each password/token independently, e.g. openssl rand -hex 32.
POSTGRES_PASSWORD=

# REQUIRED: separate replication/storage role password, shared by PostgreSQL's
# init script and PowerSync. Do not reuse the owner password.
# Production passes it unchanged through explicit PowerSync credential fields.
POWERSYNC_DB_PASSWORD=

# REQUIRED for production: random HS256 signing secret of at least 32 bytes.
# Shared by backend and PowerSync; production derives PS_JWK_K automatically.
JWT_SECRET=

# REQUIRED for production: independent random PowerSync admin API token.
PS_API_TOKEN=

# REQUIRED for production: comma-separated EXACT client origins; do not use *.
# Desktop origins commonly include tauri://localhost, http://tauri.localhost,
# and https://tauri.localhost. Add only the origins your deployed clients use.
# Angular development uses http://localhost:4200.
CORS_ALLOWED_ORIGINS=

# NOT REQUIRED: database name and owner, shared across all three services.
# POSTGRES_DB=sastaPos
# POSTGRES_USER=postgres

# NOT REQUIRED: production backend host port (container port is fixed at 8080).
# BACKEND_PORT=8090
# NOT REQUIRED: production PowerSync host port (container port is fixed at 8081).
# PS_PORT=8081
# NOT REQUIRED: production services bind to loopback for a local TLS reverse proxy.
# Override only for a private ingress network; do not expose plaintext publicly.
# SERVICE_BIND_ADDRESS=127.0.0.1

# NOT REQUIRED: local production backend image tag (built from ./backend).
# BACKEND_IMAGE=sasta-pos-backend:prod
# NOT REQUIRED: PostgreSQL image; default matches the development reference.
# POSTGRES_IMAGE=postgres:18-alpine
# NOT REQUIRED: PowerSync image; default is pinned to a tested digest.
# Overrides must retain the /app/service/lib/entry.js Node entrypoint contract.
# POWERSYNC_IMAGE=journeyapps/powersync-service@sha256:bf46f66e5dcc8f6a084de02ab51155dfa655bc610aa95009fff1c36f949c0acf

# NOT REQUIRED: application defaults, forwarded to the production backend.
# JWT_EXPIRATION_SECONDS=3600
# PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=15
# DEFAULT_CURRENCY_CODE=PKR
# DEFAULT_TIMEZONE=Asia/Karachi

# Development backend runs on the host using its default local credentials.
# Production constructs JDBC settings automatically: no duplicate secrets.
