# Standalone backend configuration. Spring Boot does NOT auto-load .env:
# supply these variables through your process environment, IDE or --env-file.
# Root production Compose uses ../.env instead and maps its shared values here.
# REQUIRED means set explicitly; NOT REQUIRED means the default is sufficient.
# Development-only defaults must not be used as production secrets.

# REQUIRED for a remote/container database; NOT REQUIRED for the default local DB.
# Default: jdbc:postgresql://localhost:5432/sastaPos. In Docker, use the DB hostname,
# not localhost. Root production Compose constructs this from POSTGRES_DB.
# JDBC_DATABASE_URL=jdbc:postgresql://localhost:5432/sastaPos
# NOT REQUIRED if the database owner is postgres (the default).
# JDBC_DATABASE_USERNAME=postgres
# REQUIRED for production or any DB with a non-default password.
# Local development fallback is postgres; never use that password in production.
JDBC_DATABASE_PASSWORD=

# REQUIRED for production: set prod explicitly (application fallback is dev).
# Supported profiles: dev, prod, staging. Docker image default: prod.
SPRING_PROFILES_ACTIVE=prod

# REQUIRED for production: exact, comma-separated client origins, not *.
# Default: all origins in dev, none in prod/staging.
# Desktop: tauri://localhost,http://tauri.localhost,https://tauri.localhost
# Angular development: http://localhost:4200. Allow only your actual clients.
CORS_ALLOWED_ORIGINS=

# REQUIRED for production: random HS256 signing secret of at least 32 bytes.
# Generate with openssl rand -hex 32. PowerSync PS_JWK_K must be the base64url
# encoding of these exact bytes; root production Compose derives it for you.
# Unset in development only: application uses an insecure built-in dev secret.
JWT_SECRET=

# NOT REQUIRED: access token lifetime in seconds; default 3600 (one hour).
# JWT_EXPIRATION_SECONDS=3600
# NOT REQUIRED: password reset token lifetime in minutes; default 15.
# PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=15
# NOT REQUIRED: new-store defaults; currency PKR and timezone Asia/Karachi.
# DEFAULT_CURRENCY_CODE=PKR
# DEFAULT_TIMEZONE=Asia/Karachi

# NOT REQUIRED: HTTP port. Default: 8090 in dev; 8080 in prod/staging and Docker.
# SERVER_PORT=8080

# NOT REQUIRED in Docker: the image already sets these production-safe defaults.
# For a standalone production JAR, set these explicitly: the prod YAML currently
# uses Hibernate update with Flyway disabled. Review/baseline existing DBs first.
# SPRING_JPA_HIBERNATE_DDL_AUTO=validate
# SPRING_JPA_SHOW_SQL=false
# SPRING_FLYWAY_ENABLED=true
# SPRING_FLYWAY_LOCATIONS=classpath:db/migration
# SPRING_FLYWAY_BASELINE_ON_MIGRATE=false

# NOT REQUIRED in Docker: image default reserves 25% of memory for native use.
# JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError -Duser.timezone=UTC"
