# Copy this file to .env. Never commit .env.
# Self-hosted PowerSync service URL (PS_PORT in ../powersync/.env). Defaults to http://localhost:8081 if unset.
# The sync token is the backend JWT obtained at login; no dev token is needed.
POWERSYNC_ENDPOINT=http://localhost:8081
# Spring Boot backend that receives uploaded local changes (POST /api/sync/upload). Defaults to http://localhost:8090 if unset.
API_BASE_URL=http://localhost:8090
