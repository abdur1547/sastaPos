{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "point_of_sale",
  "version": "0.1.0",
  "identifier": "com.sastapos",
  "build": {
    "frontendDist": "../dist/angular-starter/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "yarn start",
    "beforeBuildCommand": "yarn build:prod"
  },
  "app": {
    "windows": [
      {
        "title": "SadaPOS",
        "width": 1500,
        "height": 1000,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
